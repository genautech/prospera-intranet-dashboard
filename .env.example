# Copie para `.env.local` (não versionado) e preencha.
# Na Vercel, cadastre as mesmas chaves em Production e Preview.

# URL do projeto Supabase (Dashboard → Settings → API).
# Prefixo NEXT_PUBLIC_: entra no bundle do browser.
NEXT_PUBLIC_SUPABASE_URL=

# Chave anon / publishable do Supabase. Pública no cliente.
# Nunca coloque a service_role nesta variável.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role — somente servidor. Nunca use prefixo NEXT_PUBLIC_.
# O código atual não lê esta variável (o cliente usa a anon + RLS).
# Obrigatória no build da Vercel para fail-closed e uso futuro privilegiado.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo compartilhado para POST /api/agent-runs (header x-agent-token).
# Só no servidor. Não prefixe com NEXT_PUBLIC_.
AGENT_RUNS_TOKEN=

# --- Opcionais (só fazem sentido em máquina local; na Vercel ficam vazias) ---

# Vault Obsidian principal. Padrão: ~/notes
OBSIDIAN_VAULT_PATH=

# Vault EMAI. Padrão: ~/EMAI Starter Vault
EMAI_VAULT_PATH=

# Skills do Hermes. Padrão: ~/.hermes/skills
HERMES_SKILLS_PATH=

# Refinaria do curso OPERADOR. Padrão: ~/infoprod/operador-course
OPERADOR_COURSE_PATH=
